---
import "../styles/global.css";
import site from "../data/site.json";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const { title, description = site.description, noindex = false, jsonLd = [] } = Astro.props;
const fullTitle = title === site.name ? `${site.name}|${site.tagline}` : `${title}|${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.company,
  url: new URL("/about/", Astro.site).href,
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container-wide inner">
        <a class="brand" href="/">{site.name}<small>{site.nameNote}</small></a>
        <nav class="site-nav" aria-label="メインメニュー">
          <a href="/category/find/">探す</a>
          <a href="/category/select/">選ぶ</a>
          <a href="/category/contract/">契約する</a>
          <a href="/category/manage/">進める</a>
          <a href="/category/tools-compare/">ツール比較</a>
          <a href="/tools/">無料ツール</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container-wide">
        <div class="footer-grid">
          <div>
            <strong>{site.name}</strong>
            <p>{site.tagline}</p>
            <p class="small">運営: {site.company}</p>
          </div>
          <div>
            <strong>カテゴリ</strong>
            <ul>
              <li><a href="/category/find/">外注先を探す</a></li>
              <li><a href="/category/select/">選び方</a></li>
              <li><a href="/category/contract/">発注・契約</a></li>
              <li><a href="/category/manage/">プロジェクト管理</a></li>
              <li><a href="/category/payment/">支払い・会計</a></li>
              <li><a href="/category/tools-compare/">ツール比較</a></li>
            </ul>
          </div>
          <div>
            <strong>運営について</strong>
            <ul>
              <li><a href="/about/">運営会社</a></li>
              <li><a href="/about/profile/">運営者プロフィール</a></li>
              <li><a href="/policy/editorial/">編集方針</a></li>
              <li><a href="/policy/advertising/">広告・アフィリエイトポリシー</a></li>
              <li><a href="/policy/privacy/">プライバシーポリシー</a></li>
              <li><a href="/policy/terms/">利用規約</a></li>
              <li><a href="/contact/">お問い合わせ・情報訂正</a></li>
            </ul>
          </div>
        </div>
        <p class="small" style="margin-top:24px">
          当サイトには広告(アフィリエイトリンク)を含むページがあります。広告を含むページには、その旨をページ冒頭とリンクの直前に表示しています。
          掲載内容は一般的な情報であり、法律・税務の個別の判断は専門家にご相談ください。
        </p>
      </div>
    </footer>
  </body>
</html>
